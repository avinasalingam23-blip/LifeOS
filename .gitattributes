# Normalize source and documentation; retain Windows launcher line endings.
* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.sql text eol=lf
*.spec text eol=lf
*.svg text eol=lf
*.txt text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.png binary
*.ico binary
*.jpg binary
*.webp binary
